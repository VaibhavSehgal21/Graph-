class dsu
{
    vector<int> rank;
    vector<int> size;
    vector<int> parent;

public:
    dsu(int n)
    {

        rank.resize(n + 1, 0);
        size.resize(n + 1, 1);
        parent.resize(n + 1);
        iota(parent.begin(), parent.end(), 0);
    }

    int find(int u)
    {

        if (parent[u] == u)
        {
            return u;
        }

        return parent[u] = find(parent[u]);
    }

    bool unionByRank(int u, int v)
    {

        int a = find(u);
        int b = find(v);

        if (a == b)
        {
            return false;
        }

        if (rank[a] == rank[b])
        {
            rank[a]++;
            parent[b] = a;
        }

        else if (rank[a] > rank[b])
        {
            parent[b] = a;
        }
        else if (rank[a] < rank[b])
        {
            parent[a] = b;
        }

        return true;
    }
    bool unionBySize(int u, int v)
    {

        int a = find(u);
        int b = find(v);

        if (a == b)
        {
            return false;
        }

        if (size[a] >= size[b])
        {
            size[a] += size[b];
            parent[b] = a;
        }

        else if (size[a] < size[b])
        {
            size[b] += size[a];
            parent[a] = b;
        }

        return true;
    }
};

