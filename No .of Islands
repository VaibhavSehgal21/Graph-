class dsu {
  public :
  
  vector<int> parent,rank;
  
  dsu(int n) : parent(n),rank(n){
       
        for(int i=0;i<n;i++){
            parent[i]=i;
            rank[i]=0;
        }
        
  }
  
  int find(int node){
      
      if(parent[node]==node){
          return node;
      }
      return parent[node]=find(parent[node]);
  }
  
  
  void ubr(int u,int v){
      
      
      int ult_u=find(u);
      int ult_v=find(v);
      
      if(rank[ult_u]>rank[ult_v]){
         
         parent[ult_v]=ult_u; 
      }
      
      else if (rank[ult_u]<rank[ult_v]){
           parent[ult_u]=ult_v; 
      }
      
      else{
           parent[ult_u]=ult_v; 
           rank[ult_u]++;
      }
  }
  
};

class Solution {
  public:
  
    vector<int> numOfIslands(int n, int m, vector<vector<int>> &operators) {
        // code here
        int ind=n*m;
       dsu ds(ind);
       vector<vector<int>> vis(n,vector<int>(m,0));
       vector<int> ans ;
       int cnt=0;
       
       vector<vector<int>> dir={{0,1},{1,0},{-1,0},{0,-1}};
       
       for(auto x : operators){
           
          int row = x[0];
          int col = x[1];
           
           
            if (vis[row][col] == 1) {
                ans.push_back(cnt);
                continue;
            }
           
           
           vis[x[0]][x[1]]=1;
           cnt++;
           
           
           for(auto y : dir){
               
               int nx=x[0]+y[0];
               int ny=x[1]+y[1];
               
               if(nx>=0 && nx<n && ny>=0 && ny<m && vis[nx][ny]){
                   
                   int arr_ind1=nx*m+ny;
                   int arr_ind2=x[0]*m+x[1];
                   
                  if(ds.find(arr_ind1)!=ds.find(arr_ind2)){
                      ds.ubr(arr_ind1,arr_ind2);
                      cnt--;
                  } 
                   
                   
                   
               }
           }
           
           
           
           ans.push_back(cnt);
       }
       
       
       
       return ans ;
       
    }
};
